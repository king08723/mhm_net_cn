{
  "name": "mypage",
  "private": true,
  "scripts": {
    "inject": "node scripts/inject_partials.js",
    "optimize:html": "node scripts/optimize_html.js",
    "build:css": "tailwindcss -i ./css/site-src.css -o ./css/site.css --minify",
    "watch:css": "tailwindcss -i ./css/site-src.css -o ./css/site.css --watch",
    "build:quant": "esbuild js/quant.js --bundle --outfile=js/quant.bundle.js --format=esm --minify",
    "build": "npm run inject && npm run optimize:html && npm run build:css && npm run build:quant",
    "watch": "node watch-deploy.js",
    "deploy": "npm run build && node watch-deploy.js --once"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
